<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <StartupObject>RegionConsole.Program</StartupObject>
    <TargetFramework>net472</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>RegionConsole</AssemblyName>
    <RootNamespace>RegionConsole</RootNamespace>
    <ApplicationIcon>Resources\region_console.ico</ApplicationIcon>
    <Version>1.0.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Nullable>disable</Nullable>
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="MainForm.cs" />
    <Compile Include="Validators.cs" />
    <Compile Include="TerminalEngine.cs" />
    <Compile Include="Netsh.cs" />
    <Compile Include="IcsManager.cs" />
    <None Include="Resources\region_console.ico" />
    <Content Include="Resources\icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
